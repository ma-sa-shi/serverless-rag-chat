# .envへコピーし、DataStack/AppStackデプロイ後の値を設定する(cdk/README.md参照)
# make devは、このディレクトリに.envがあれば読み込む

# DataStackのTableName出力。未設定だと/api/health以外が500になる
TABLE_NAME=
# DataStackのCognitoIssuer / UserPoolClientId出力。JWT検証に使う
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
# DataStackのCognitoDomain出力。サインインと更新でHosted UIを呼ぶ
COGNITO_DOMAIN=
# Viteの開発サーバーのオリジン。Cognitoのコールバック先とCSRF検証に使う
APP_ORIGIN=http://localhost:5173
# 署名付きURLの発行と、取込のキューイングに使う
DOCUMENTS_BUCKET_NAME=
INGEST_QUEUE_URL=
# DataStackのVectorIndexArn出力。チャットのベクトル検索に使う
VECTOR_INDEX_ARN=

# 1ユーザーが1日に送れるチャット数。未設定なら20
CHAT_DAILY_QUOTA=20

# ローカルにはX-Rayデーモンが無いためトレースは無効化する
POWERTOOLS_TRACE_DISABLED=true
POWERTOOLS_SERVICE_NAME=local
POWERTOOLS_METRICS_NAMESPACE=EventDrivenRag

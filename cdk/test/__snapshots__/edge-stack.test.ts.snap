function handler(event) {
  var request = event.request;
  var uri = request.uri;
  // 拡張子付き(=静的アセット)とルート以外はSPAのエントリポイントへ寄せる
  if (!uri.includes('.')) {
    request.uri = '/index.html';
  }
  return request;
}
",
